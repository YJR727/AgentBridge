<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agent Bridge" Width="760" Height="800" MinWidth="680" MinHeight="600"
        Background="#F3F6F5" WindowStartupLocation="CenterScreen" FontFamily="Microsoft YaHei UI"
        FontSize="14" Foreground="#18352F" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
  <Window.Resources>
    <SolidColorBrush x:Key="Accent" Color="#0F766E"/>
    <Style TargetType="Button">
      <Setter Property="FontFamily" Value="Microsoft YaHei UI"/><Setter Property="FontSize" Value="14"/>
      <Setter Property="MinHeight" Value="44"/><Setter Property="Padding" Value="18,10"/>
      <Setter Property="Background" Value="#E8F3F0"/><Setter Property="Foreground" Value="#145B54"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.85"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.7"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#225FCC"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="24"/><Setter Property="Margin" Value="0,0,0,16"/><Setter Property="BorderBrush" Value="#E3EBE7"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="#536A62"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="23"/></Style>
  </Window.Resources>
  <Border Background="#F3F6F5"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel x:Name="Page" Margin="30,26,30,22">
      <Grid Margin="0,0,0,24">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <Image x:Name="Logo" Width="48" Height="48" Margin="0,0,14,0"/>
          <StackPanel><TextBlock Text="Agent Bridge" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="让 Codex 随时在你身边" Style="{StaticResource Muted}" FontSize="13"/></StackPanel>
        </StackPanel>
        <Border Grid.Column="1" Background="#E4F2EC" CornerRadius="16" Padding="12,8" VerticalAlignment="Center">
          <TextBlock x:Name="Badge" Text="正在连接" Foreground="#16624A" FontSize="12"/>
        </Border>
      </Grid>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="连接概况" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12"/>
          <TextBlock x:Name="ServiceState" Text="正在启动服务…" FontSize="15" FontWeight="Medium" Margin="0,0,0,6"/>
          <TextBlock x:Name="ChatState" Text="在手机选择要继续的 Codex 聊天。" Style="{StaticResource Muted}"/>
          <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="TailscaleState" Text="Tailscale：正在检测…" FontWeight="Medium" FontSize="14" AutomationProperties.LiveSetting="Polite"/>
              <TextBlock x:Name="TailscaleHint" Text="检查电脑端安装与连接状态。" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="TailscaleAction" Content="打开 Tailscale" Padding="12,8" FontSize="12"/>
              <Button x:Name="TailscaleRefresh" Content="重新检测" Padding="12,8" FontSize="12" Margin="8,0,0,0"/>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="手机与 iPad 访问地址" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12"/>
          <Border Background="#F5F8F7" BorderBrush="#D9E5DF" BorderThickness="1" CornerRadius="9" Padding="12,10">
            <TextBox x:Name="Address" BorderThickness="0" Background="Transparent" FontSize="14" Padding="0" AutomationProperties.Name="手机与 iPad 访问地址"/>
          </Border>
          <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Button x:Name="Copy" Content="复制地址"/><Button x:Name="Open" Grid.Column="2" Content="打开网页"/>
          </Grid>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="设备配对" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8"/>
            <TextBlock x:Name="PairCode" Text="—" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
            <TextBlock x:Name="PairHint" Text="正在读取配对状态…" Style="{StaticResource Muted}" FontSize="13" Margin="0,6,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="2" VerticalAlignment="Center">
            <Button x:Name="AddDevice" Content="添加设备" Background="{StaticResource Accent}" Foreground="White" IsEnabled="False"/>
            <Button x:Name="Reset" Content="重新配对" Margin="0,8,0,0" IsEnabled="False"/>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Button x:Name="Toggle" Content="启动服务"/><Button x:Name="Test" Grid.Column="2" Content="通知测试" IsEnabled="False"/><Button x:Name="LogToggle" Grid.Column="4" Content="查看日志"/>
      </Grid>
      <TextBlock x:Name="Feedback" Text="关闭窗口后，Agent Bridge 会在系统托盘继续运行。" Style="{StaticResource Muted}" FontSize="12" Margin="2,0,2,12" AutomationProperties.LiveSetting="Polite"/>
      <Border x:Name="LogPanel" Style="{StaticResource Card}" Visibility="Collapsed" Padding="14">
        <StackPanel><TextBlock Text="运行日志" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <TextBox x:Name="Logs" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Height="200" FontFamily="Consolas" FontSize="12" BorderThickness="0" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="运行日志"/>
        </StackPanel>
      </Border>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="Agent Bridge 0.2.5" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/>
        <Button x:Name="Exit" Grid.Column="1" Content="退出程序" MinHeight="30" Padding="12,5" FontSize="12" Background="Transparent"/>
      </Grid>
    </StackPanel>
  </ScrollViewer></Border>
</Window>
